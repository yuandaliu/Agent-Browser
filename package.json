{
  "name": "local-llm-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "在浏览器中运行本地小模型智能体：BrowserAI + ReAct 循环 + 工具系统 + IndexedDB 记忆",
  "scripts": {
    "dev": "vite",
    "proxy": "node server/dev-proxy.mjs",
    "build": "vite build",
    "build:embed": "vite build --config vite.embed.config.js",
    "preview": "vite preview",
    "lint": "eslint src tests server",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tests/e2e.mjs",
    "test:embed": "node tests/e2e-embed-probe.mjs",
    "test:search": "node tests/e2e-search-probe.mjs"
  },
  "dependencies": {
    "@missionsquad/browserai": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.0.0",
    "playwright-core": "^1.54.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.0"
  }
}
